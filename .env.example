# Root .env is read by contracts scripts, services and demo scripts.
# Testnet-only keys; generate your own with `cast wallet new`.
RPC_URL=https://testnet-rpc.monad.xyz
RPC_WS_URL=wss://testnet-rpc.monad.xyz
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
RELAYER_KEY=
RELAYER_ADDRESS=
PROVIDER_A_KEY=
PROVIDER_A_ADDRESS=
NODE_A_KEY=
NODE_A_ADDRESS=
PROVIDER_B_KEY=
PROVIDER_B_ADDRESS=
NODE_B_KEY=
NODE_B_ADDRESS=
PROBE_KEY=
PROBE_ADDRESS=
MM_KEY=
MM_ADDRESS=
BUYER_A_KEY=
BUYER_A_ADDRESS=
BUYER_B_KEY=
BUYER_B_ADDRESS=
JUDGE_KEY=
JUDGE_ADDRESS=
# optional
# FORWARDER_ADDRESS=        defaults to the CRE MockKeystoneForwarder on Monad Testnet
# DEMO_HOUR_SECONDS=300     one delivery hour in demo mode
# ENVIO_URL=                Envio GraphQL for the relay's Mark & Margin
# RELAY_MODE=cre|local      cre: run `cre workflow simulate --broadcast`; local: in-process + relayReport

# Envio HyperSync token (envio.dev → API tokens); the indexer falls back to RPC without it
ENVIO_API_TOKEN=
