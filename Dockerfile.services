# One image for every Silica service; pick the process with SERVICE=agent|probe|mm|relay.
# Keys come from the host's secret settings at runtime, never from the image.
FROM node:22-slim
RUN corepack enable
WORKDIR /app

# workspace manifests first, so the dependency layer caches
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY services/package.json services/
COPY apps/web/package.json apps/web/
COPY contracts/package.json contracts/
COPY indexer/package.json indexer/
RUN pnpm install --frozen-lockfile --filter "@silica/services..."

COPY packages/shared packages/shared
COPY services services

ENV SERVICE=agent
CMD ["sh", "-c", "pnpm --filter @silica/services \"$SERVICE\""]
