# Monad Testnet RPCs (primary + fallback)
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_FALLBACK=https://rpc.ankr.com/monad_testnet
# Envio HyperIndex GraphQL endpoint (local: http://localhost:8080/v1/graphql)
NEXT_PUBLIC_ENVIO_URL=
# Reown (WalletConnect) project id; injected wallets work without it
NEXT_PUBLIC_WALLETCONNECT_ID=
# Public site URL for OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Simulated testnet providers (names on the risk panel) and the hosted buyer probe
NEXT_PUBLIC_PROVIDER_A=
NEXT_PUBLIC_PROVIDER_B=
NEXT_PUBLIC_PROBE_ADDRESS=
# Demo controls on /tickets (provider-agent and buyer-probe base URLs)
NEXT_PUBLIC_AGENT_URL=
NEXT_PUBLIC_PROBE_URL=
NEXT_PUBLIC_HOUR_SECONDS=300
# DEV ONLY (localhost): a testnet test key for the burner wallet. Never set in production.
NEXT_PUBLIC_DEV_BURNER_KEY=
